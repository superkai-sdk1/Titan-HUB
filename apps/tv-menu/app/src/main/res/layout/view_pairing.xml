<?xml version="1.0" encoding="utf-8"?>
<!-- Приставка ещё не подключена к экрану: код для телефона и подсказка, что делать. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/pair_title"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pair_code_label"
        android:textColor="@color/muted"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/pair_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="0.18"
        android:textColor="@color/accent"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:maxWidth="620dp"
        android:text="@string/pair_steps"
        android:textColor="@color/text"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/pair_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/muted"
        android:textSize="15sp" />
</LinearLayout>
